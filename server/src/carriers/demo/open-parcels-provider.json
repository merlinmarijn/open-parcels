{
  "schema": 1,
  "id": "demo",
  "name": "Demo courier",
  "countries": ["*"],
  "provides": {
    "connections": ["account", "tracking"],
    "live": true,
    "fallback": false
  },
  "permissions": {
    "network": [],
    "image_hosts": ["placehold.co"],
    "secrets": [],
    "session": false,
    "user_agent": false
  },
  "actions": [
    {
      "id": "import_history",
      "kind": "task",
      "label": "Import history",
      "description": "Reads the demo parcels again, one page at a time.",
      "connection_kinds": ["account"],
      "weight": "light",
      "expose_to_ha": true
    }
  ]
}
